# Copia este archivo a .env.local para desarrollo local (nunca subas .env.local a GitHub)
# En producción (GitHub Pages), esta variable se configura como "Repository secret"
# y se inyecta en el build mediante GitHub Actions.
#
# Ya NO se necesita una API key fija aquí: la autenticación ahora es por
# login (email + password) contra /api/auth.php, que devuelve un token JWT
# que la app guarda automáticamente en sessionStorage.

VITE_API_BASE_URL=https://groundstakegroup.com/api
